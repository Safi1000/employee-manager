<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      allowBackup is OFF deliberately. Android's auto-backup would copy
      SharedPreferences — which is where the Supabase session and refresh token
      live (see src/app/lib/authStorage.ts) — to the user's Google Drive, and
      restore it onto any new device signing in with that Google account. That
      is a CRM session for a security company being cloned to an unvetted
      device. Turning it off costs nothing: the app holds no local state worth
      restoring, everything is server-side.
    -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              App Links: a Supabase password-reset or email-confirm link points
              at the website, and with this filter tapping one on a device that
              has the app installed opens the app instead of the browser. The
              deep link is mapped onto an in-app route by wireDeepLinks() in
              src/app/lib/nativeShell.ts.

              android:autoVerify requires a matching assetlinks.json served from
              https://txs-crm.techxserve.com/.well-known/assetlinks.json — see
              docs/MOBILE.md. WITHOUT that file Android silently falls back to
              showing a "open with" chooser instead of going straight to the
              app, so this is not done until the file is deployed.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="txs-crm.techxserve.com" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
