{
  "expo": {
    "name": "GGS Field",
    "slug": "ggs-field",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "pk.ggs.field"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0e100b",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "pk.ggs.field",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ]
    },
    "plugins": [
      "expo-font",
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "GGS Field records where you are when you confirm attendance, visit a site or report an incident.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "GGS Field uses the camera for visit, incident and guard photos.",
          "photosPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "ggsfield"
  }
}
